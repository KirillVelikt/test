<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="настройки терминала"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="НАЗВАНИЕ ТЕРМИНАЛА"
        android:letterSpacing="0.1"
        android:textColor="#4ADE80"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_dark"
        android:hint="терминал"
        android:inputType="text"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#6B7280" />

    <Switch
        android:id="@+id/swSounds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="звуки"
        android:textColor="#FFFFFF"
        android:textSize="17sp" />

    <Switch
        android:id="@+id/swKeepScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="экран не гаснет при оплате"
        android:textColor="#FFFFFF"
        android:textSize="17sp" />

    <Switch
        android:id="@+id/swVibrate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="вибрация при оплате"
        android:textColor="#FFFFFF"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_card_green"
        android:gravity="center"
        android:padding="18dp"
        android:text="готово"
        android:textColor="#0C2B12"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
